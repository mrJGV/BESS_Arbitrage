*.log
hpc/logs/

# A backtest summary is minutes of local compute from a committed snapshot,
# so it is regenerated rather than tracked. results/annual_bound*.json stays
# committed: it is the run a reader without a cluster cannot reproduce.
results/backtest_*.json

